<resources>
    <style name="Theme.CarCast" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/carcast_icon_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CarCast.Main</item>
    </style>

    <style name="Theme.CarCast.Main" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand_cyan</item>
        <item name="android:navigationBarColor">@color/brand_navy</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
